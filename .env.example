# Bu dosyayi .env olarak kopyala ve doldur. .env repoya GIRMEZ (.gitignore).
# deploy.py bu degerleri ortam degiskeni olarak okur.
NET_USER=admin
NET_PASS=
NET_ENABLE=
NET_OSPF_KEY=      # extensions/security-hardening: OSPF MD5 anahtari
NET_SNMP_RO=       # extensions/monitoring: SNMP salt-okunur topluluk dizgisi
# NET_SNMP_STATION=172.16.90.0 0.0.0.255   # izleme istasyonu (ACL-SNMP); varsayilan yonetim agi
