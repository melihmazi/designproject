ipv6 unicast-routing
ipv6 router ospf 1
 router-id {{ router_id }}
 auto-cost reference-bandwidth 10000
 passive-interface default
{% for i in transit %}
 no passive-interface {{ i }}
{% endfor %}
interface Loopback0
 ipv6 address {{ v6.loopbacks }}::{{ rid }}/128
 ipv6 ospf 1 area 0
{# Transit linklerde global adres yok: OSPFv3 link-local uzerinden komsuluk kurar #}
{% for i in transit %}
interface {{ i }}
 ipv6 enable
 ipv6 ospf network point-to-point
 ipv6 ospf 1 area 0
{% endfor %}
