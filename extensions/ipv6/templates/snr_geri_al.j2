no ipv6 route ::/0 {{ v6.wan }}::2
interface Tunnel0
 no ipv6 ospf 1 area 300
 no ipv6 ospf network point-to-point
 no ipv6 mtu 1400
 no ipv6 enable
interface {{ wan_if }}
 no ipv6 address {{ v6.wan }}::1/64
{% for i in transit %}
interface {{ i }}
 no ipv6 ospf 1 area 0
 no ipv6 ospf network point-to-point
 no ipv6 enable
{% endfor %}
interface Loopback0
 no ipv6 ospf 1 area 0
 no ipv6 address {{ v6.loopbacks }}::{{ rid }}/128
no ipv6 router ospf 1
no ipv6 unicast-routing
