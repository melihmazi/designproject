vtp mode transparent
spanning-tree mode rapid-pvst
vlan {{ net.fab_lan.vlan }}
 name {{ net.fab_lan.name }}
interface range {{ access_range }}
 switchport mode access
 switchport access vlan {{ net.fab_lan.vlan }}
 spanning-tree portfast
 no shutdown
interface Vlan{{ net.fab_lan.vlan }}
 ip address {{ mgmt_ip }} 255.255.255.0
 no shutdown
ip default-gateway {{ net.fab_lan.prefix }}.1
{# IOSvL2'de ip routing varsayilan ACIK: ip default-gateway yok sayilir, baska VLAN'dan yonetim adresine
   ulasilamaz (13 cihazli canli testte A6 kaldi). Statik varsayilan rota iki durumda da calisir. #}
ip route 0.0.0.0 0.0.0.0 {{ net.fab_lan.prefix }}.1
